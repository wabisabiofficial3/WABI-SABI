# Copy to .env for a local instance. Do not commit .env or real credentials.
# On first production boot, set a unique WABI_ADMIN_PASSWORD (12+ characters).
# In local development, omitting it generates a random one-time password in data/.
# WABI_ADMIN_PASSWORD=

WABI_ADMIN_EMAIL=wabisabiofficial3@gmail.com
WABI_ADMIN_HANDLE=admin

# Public origin used when generating QR membership passes (required in production).
# APP_BASE_URL=https://your-public-domain.example

# The service is normally behind one trusted reverse proxy. For direct deployments,
# set this to 0; if your hosting topology differs, configure the exact hop count.
TRUST_PROXY_HOPS=1

# Comma-separated exact trusted origins for optional cross-origin browser clients.
# Same-origin requests need no entry.
# CORS_ALLOWED_ORIGINS=

# Arena HTTPS iframe previews only: opt curator sessions into CHIPS so browsers can
# keep them partitioned in the preview frame. Leave disabled in production.
# WABI_PREVIEW_PARTITIONED_COOKIES=false

# Optional custom SQLite path. Defaults to data/wabisabi.db.
# WABI_DB_PATH=
